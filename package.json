{
  "name": "kinderkopje",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Season overview and race-thread generator for Reddit moderators (r/xcworldcup, r/peloton). Runs entirely in the browser.",
  "scripts": {
    "build": "node build.mjs",
    "beta": "node scripts/build-beta.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "start": "node dist/serve.mjs"
  },
  "dependencies": {
    "sql.js": "^1.15.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
